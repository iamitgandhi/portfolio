---
/**
 * 404.astro — Creative "lost in the code" 404 page
 * Matches the portfolio's design tokens (surface / ink / accent / tag-*)
 * and Inter + JetBrains Mono font stack.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteContent } from "@/data";

const meta = {
  title: "404 — Page Not Found | Amit Kumar Gandhi",
  description: "Oops! This page doesn't exist. Head back to Amit Kumar Gandhi's portfolio.",
  author: siteContent.meta.author,
};
---

<BaseLayout meta={meta} social={siteContent.social}>
  <main class="not-found-root">

    <!-- Animated code-rain background -->
    <canvas id="rain" aria-hidden="true"></canvas>

    <div class="content">

      <!-- Glitchy 404 heading -->
      <div class="error-code" aria-hidden="true">
        <span class="digit" style="--d:0">4</span>
        <span class="digit zero" style="--d:1">0</span>
        <span class="digit" style="--d:2">4</span>
      </div>
      <p class="sr-only">404 – Page not found</p>

      <!-- Terminal-style message block -->
      <div class="terminal" role="status">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title">amit@portfolio ~ bash</span>
        </div>
        <div class="terminal-body">
          <p class="line">
            <span class="prompt">$</span>
            <span class="cmd" id="typed-cmd"></span><span class="cursor">▋</span>
          </p>
          <p class="output">
            <span class="err">Error:</span> Route <code class="route" id="route-path"></code> not found.
          </p>
          <p class="output hint">
            Looks like this page wandered off. Maybe check your URL or head back home.
          </p>
          <p class="output cta-line">
            <span class="prompt">$</span>
            <a href="/" class="home-link">cd ~/home &amp;&amp; ./portfolio.sh</a>
          </p>
        </div>
      </div>

      <!-- Quick-nav chips -->
      <nav class="chips" aria-label="Quick navigation">
        <a href="/" class="chip">← Home</a>
        <a href="/#experience" class="chip">Experience</a>
        <a href="/#projects" class="chip">Projects</a>
        <a href="/#contact" class="chip">Contact</a>
      </nav>

    </div>
  </main>
</BaseLayout>

<style>
  /* ─── Layout ─── */
  .not-found-root {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: hsl(var(--surface));
    padding: 2rem 1.25rem;
  }

  #rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.06;
    pointer-events: none;
    z-index: 0;
  }

  @media (prefers-color-scheme: dark) {
    #rain { opacity: 0.12; }
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    max-width: 600px;
    width: 100%;
    animation: fade-up 0.55s ease-out both;
  }

  /* ─── 404 Heading ─── */
  .error-code {
    display: flex;
    gap: 0.15em;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: clamp(5rem, 20vw, 10rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
    color: hsl(var(--ink));
    user-select: none;
  }

  .digit {
    display: inline-block;
    animation: glitch-in 0.6s calc(var(--d) * 0.12s) ease-out both;
    position: relative;
  }

  /* The middle "0" pulses the accent colour */
  .zero {
    color: hsl(var(--accent));
    animation:
      glitch-in 0.6s calc(var(--d) * 0.12s) ease-out both,
      pulse-zero 3s 1.2s ease-in-out infinite;
  }

  @keyframes glitch-in {
    0%   { opacity: 0; transform: translateY(-20px) skewX(8deg); }
    60%  { transform: translateY(4px) skewX(-2deg); }
    100% { opacity: 1; transform: translateY(0) skewX(0deg); }
  }

  @keyframes pulse-zero {
    0%, 100% { text-shadow: none; }
    50% {
      text-shadow:
        0 0 18px hsl(var(--accent) / 0.5),
        0 0 40px hsl(var(--accent) / 0.2);
    }
  }

  /* ─── Terminal ─── */
  .terminal {
    width: 100%;
    background: hsl(var(--surface-muted));
    border: 1px solid hsl(var(--line));
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 24px hsl(0 0% 0% / 0.08);
    animation: fade-up 0.55s 0.25s ease-out both;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: hsl(var(--line) / 0.6);
    border-bottom: 1px solid hsl(var(--line));
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .red    { background: #ff5f57; }
  .yellow { background: #febc2e; }
  .green  { background: #28c840; }

  .terminal-title {
    margin-left: 6px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    color: hsl(var(--ink-faint));
  }

  .terminal-body {
    padding: 1.2rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.82rem;
  }

  .line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: hsl(var(--ink));
    margin: 0;
  }

  .prompt {
    color: hsl(var(--accent));
    font-weight: 600;
    flex-shrink: 0;
  }

  .cmd {
    color: hsl(var(--ink));
  }

  .cursor {
    color: hsl(var(--accent));
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .output {
    margin: 0;
    color: hsl(var(--ink-muted));
    line-height: 1.6;
  }

  .err {
    color: #ef4444;
    font-weight: 600;
  }

  code.route {
    color: hsl(var(--accent));
    background: hsl(var(--tag-bg));
    padding: 0.1em 0.4em;
    border-radius: 4px;
    border: 1px solid hsl(var(--tag-edge));
    font-size: 0.85em;
  }

  .hint {
    color: hsl(var(--ink-faint));
    font-size: 0.78rem;
  }

  .cta-line {
    margin-top: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .home-link {
    color: hsl(var(--accent));
    text-decoration: none;
    position: relative;
  }

  .home-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background: hsl(var(--accent));
    transition: width 0.25s ease;
  }

  .home-link:hover::after { width: 100%; }

  /* ─── Navigation chips ─── */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    animation: fade-up 0.55s 0.45s ease-out both;
  }

  .chip {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.35em 0.85em;
    border-radius: 9999px;
    border: 1px solid hsl(var(--tag-edge));
    background: hsl(var(--tag-bg));
    color: hsl(var(--tag-fg));
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    white-space: nowrap;
  }

  .chip:hover {
    background: hsl(var(--accent));
    border-color: hsl(var(--accent));
    color: hsl(var(--accent-fg));
  }

  /* ─── Animation ─── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
    }
  }

  /* ─── SR-only ─── */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
</style>

<script>
  /* ── Code-rain canvas ── */
  const canvas = document.getElementById("rain") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");

  function initRain() {
    if (!ctx || !canvas) return;
    const cols = Math.floor(window.innerWidth / 18);
    const drops: number[] = Array(cols).fill(1);
    const chars = "01アイウエオカキクケコ{}[]<>/\\|;:$#@";

    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;

    const isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const rainColor = isDark ? "38,99%,68%" : "217,100%,42%";

    function draw() {
      ctx!.fillStyle = isDark
        ? "rgba(13,13,13,0.05)"
        : "rgba(255,255,255,0.05)";
      ctx!.fillRect(0, 0, canvas.width, canvas.height);

      ctx!.fillStyle = `hsl(${rainColor})`;
      ctx!.font = "14px 'JetBrains Mono', monospace";

      for (let i = 0; i < drops.length; i++) {
        const char = chars[Math.floor(Math.random() * chars.length)];
        ctx!.fillText(char, i * 18, drops[i] * 18);
        if (drops[i] * 18 > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }

    const interval = setInterval(draw, 60);
    window.addEventListener("resize", () => {
      clearInterval(interval);
      initRain();
    }, { once: true });
  }

  initRain();

  /* ── Show current path in terminal ── */
  const routeEl = document.getElementById("route-path");
  if (routeEl) routeEl.textContent = window.location.pathname;

  /* ── Typewriter command effect ── */
  const cmdEl = document.getElementById("typed-cmd");
  const command = `navigate ${window.location.pathname}`;
  let i = 0;
  function type() {
    if (!cmdEl) return;
    if (i < command.length) {
      cmdEl.textContent += command[i++];
      setTimeout(type, 55);
    }
  }
  setTimeout(type, 400);
</script>
