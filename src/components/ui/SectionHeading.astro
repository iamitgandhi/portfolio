---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
  class?: string;
}

const { title, subtitle, id, class: className } = Astro.props;
---

<div class:list={["mb-8 max-w-prose", className]}>
  <h2
    id={id}
    class="text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-muted"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-2 text-xs leading-relaxed text-ink-muted">{subtitle}</p>
    )
  }
</div>
