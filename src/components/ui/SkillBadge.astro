---
import {
  getSkillIconPath,
  skillIconInvertsOnDark,
} from "@/data/skill-icons";

export interface Props {
  label: string;
  icon: string;
  class?: string;
}

const { label, icon, class: className } = Astro.props;
const iconSrc = getSkillIconPath(icon);
const invertOnDark = skillIconInvertsOnDark(icon);
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-md border border-tag-edge bg-tag-bg py-1 pl-1.5 pr-2.5 font-mono text-[11px] font-medium leading-none tracking-wide text-tag-fg",
    className,
  ]}
>
  {
    iconSrc ? (
      <img
        src={iconSrc}
        alt=""
        width="14"
        height="14"
        class:list={[
          "size-3.5 shrink-0 object-contain",
          invertOnDark && "brightness-0 opacity-70",
          label === "JavaScript" && "bg-neutral-950 rounded-[3px] p-[1.5px] scale-110 shadow-sm",
        ]}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    ) : null
  }
  {label}
</span>
