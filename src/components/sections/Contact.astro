---
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import type { ContactContent } from "@/data/types";

interface Props {
  contact: ContactContent;
}

const { contact } = Astro.props;
const phoneHref = contact.phone?.replace(/[\s-]/g, "");
---

<Section id="contact" partition={false}>
  <Container>
    <div class="relative w-full p-8 sm:p-12 md:p-16 rounded-[3rem] bg-[#121212] border border-[#222222] text-center overflow-hidden flex flex-col items-center justify-center gap-6 reveal" style="color-scheme: dark;">
      
      <!-- Lavender Gear Graphic in the center -->
      <div class="relative w-20 h-20 flex items-center justify-center bg-[#A793AC]/20 text-[#A793AC] rounded-full border border-[#A793AC]/30 animate-spin [animation-duration:10s]">
        <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>

      <!-- CTA Headline -->
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white max-w-2xl leading-tight">
        Have a project in mind?<br/>Let's connect like yesterday.
      </h2>

      <!-- Description -->
      <p class="text-sm text-neutral-400 max-w-md leading-relaxed">
        {contact.intro}
      </p>

      <!-- CTA Buttons & Contact Details -->
      <div class="mt-4 flex flex-col sm:flex-row items-center gap-4">
        <a
          href={`mailto:${contact.email}`}
          class="inline-flex items-center justify-center px-8 py-3 rounded-full text-sm font-bold bg-white text-neutral-950 hover:bg-accent hover:text-white transition-all duration-200 shadow-lg"
        >
          Get in touch
        </a>
        {contact.phone && (
          <a
            href={`tel:${phoneHref}`}
            class="inline-flex items-center justify-center px-8 py-3 rounded-full text-sm font-bold border border-neutral-700 text-neutral-300 hover:border-neutral-500 transition-colors duration-200"
          >
            {contact.phone}
          </a>
        )}
      </div>

      <!-- Decorative Blur circles -->
      <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-accent/10 rounded-full blur-2xl pointer-events-none"></div>
      <div class="absolute -right-10 -top-10 w-40 h-40 bg-accent/10 rounded-full blur-2xl pointer-events-none"></div>
    </div>
  </Container>
</Section>
