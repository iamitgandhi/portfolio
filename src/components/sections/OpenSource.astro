---
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import type { OpenSourceItem } from "@/data/types";

interface Props {
  items: OpenSourceItem[];
}

const { items } = Astro.props;
---

<Section id="ventures">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Left side: Label -->
      <div class="lg:col-span-3 reveal">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent font-display">Ventures</h2>
      </div>

      <!-- Right side: Ventures Cards -->
      <div class="lg:col-span-9 grid gap-6 sm:grid-cols-2 reveal-stagger">
        {
          items.map((item) => (
            <article class="tilt-card group relative p-6 rounded-3xl border border-line bg-surface-muted shadow-sm hover:border-accent/25 transition-all duration-300 flex flex-col justify-between">
              <!-- Subtle hover glow -->
              <div class="absolute inset-0 bg-gradient-to-br from-accent/[0.04] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-3xl pointer-events-none" />

              <div class="relative flex flex-col gap-3">
                <!-- Role title -->
                <span class="text-[10px] font-bold uppercase tracking-widest text-ink-muted leading-none">{item.role}</span>
                
                <!-- Title + external link button -->
                <div class="flex items-start justify-between gap-3 mt-1">
                  <div>
                    <h3 class="text-xl font-bold text-ink font-display leading-snug">
                      {item.project}
                    </h3>
                    {item.repoHref && (
                      <div class="flex items-center gap-1.5 text-xs text-ink-muted leading-none font-medium mt-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] flex-shrink-0"></span>
                        <span>{item.repoHref.replace(/https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                      </div>
                    )}
                  </div>
                  {item.repoHref && (
                    <a
                      href={item.repoHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-7 h-7 flex items-center justify-center rounded-full border border-line bg-surface hover:bg-surface-muted hover:border-ink/20 text-ink-muted hover:text-ink transition-all duration-300 flex-shrink-0 shadow-sm"
                      aria-label={`Visit live site for ${item.project}`}
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>

                <!-- Description -->
                <p class="text-xs text-ink-muted leading-relaxed mt-1">
                  {item.description}
                </p>
              </div>

              <!-- Tech stacks / badges -->
              <div class="relative mt-6 pt-4 border-t border-line flex flex-wrap gap-1.5">
                {item.tags.map((tag) => (
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-tag-bg text-tag-fg border border-tag-edge">
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</Section>
