---
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import type { ProjectItem } from "@/data/types";

interface Props {
  items: ProjectItem[];
}

const { items } = Astro.props;
---

<Section id="projects">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12">

      <!-- Left side: Label -->
      <div class="lg:col-span-3 reveal">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent font-display">Projects</h2>
        <p class="mt-3 text-sm text-ink-muted leading-relaxed">
          A selection of client sites built and shipped.
        </p>
      </div>

      <!-- Right side: Cards + CTA -->
      <div class="lg:col-span-9 flex flex-col gap-8">

        <!-- Project cards grid -->
        <div class="grid gap-6 sm:grid-cols-2 reveal-stagger">
          {
            items.map((project) => (
              <article class="tilt-card group relative flex flex-col justify-between p-6 rounded-3xl border border-line bg-surface-muted shadow-sm hover:border-accent/30 hover:shadow-md transition-all duration-300 overflow-hidden">

                <!-- Subtle hover glow -->
                <div class="absolute inset-0 bg-gradient-to-br from-accent/[0.04] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-3xl pointer-events-none" />

                <div class="relative flex flex-col gap-3">
                  <!-- Title + external link button -->
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <h3 class="text-base font-bold text-ink font-display leading-snug">
                        {project.title}
                      </h3>
                      {project.href && (
                        <div class="flex items-center gap-1.5 text-xs text-ink-muted leading-none font-medium mt-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] flex-shrink-0"></span>
                          <span>{project.href.replace(/https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                        </div>
                      )}
                    </div>
                    {project.href && (
                      <a
                        href={project.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-7 h-7 flex items-center justify-center rounded-full border border-line hover:bg-accent/10 hover:border-accent text-ink-muted hover:text-accent transition-all duration-300 flex-shrink-0"
                        aria-label={`Visit live site for ${project.title}`}
                      >
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    )}
                  </div>

                  <!-- Description -->
                  <p class="text-xs text-ink-muted leading-relaxed mt-1">
                    {project.description}
                  </p>
                </div>

                <!-- Technologies and live badge -->
                <div class="mt-6 pt-4 border-t border-line flex flex-wrap gap-1.5 items-center justify-between">
                  <!-- Badges group -->
                  <div class="flex flex-wrap gap-1.5">
                    {project.tags.map((tag) => (
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-tag-bg text-tag-fg border border-tag-edge">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <!-- BAD Design Media CTA Banner -->
        <div
          class="reveal relative overflow-hidden rounded-3xl bg-[#121212] border border-[#222222] p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6"
          style="color-scheme: dark;"
        >
          <!-- Background glow -->
          <div class="absolute -top-12 -right-12 w-56 h-56 rounded-full bg-[#A793AC]/10 blur-3xl pointer-events-none" />
          <div class="absolute -bottom-8 -left-8 w-40 h-40 rounded-full bg-accent/5 blur-2xl pointer-events-none" />

          <div class="relative flex flex-col gap-2 text-center sm:text-left">
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#A793AC] font-display">Design & Build Agency</span>
            <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight leading-snug">
              Want a website like these?
            </h3>
            <p class="text-xs text-neutral-400 leading-relaxed max-w-sm">
              I build conversion-focused WordPress & WooCommerce sites through
              <span class="text-white font-semibold"> BAD Design Media</span> —
              fast, clean, and built to grow your brand.
            </p>
          </div>

          <a
            href="https://baddesignmedia.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="relative shrink-0 inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-bold bg-white text-neutral-950 hover:bg-[#A793AC] hover:text-white transition-all duration-300 shadow-lg whitespace-nowrap"
          >
            Visit BAD Design Media
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </Container>
</Section>
