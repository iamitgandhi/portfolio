---
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
---

<Section id="about">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Left side: Section Label -->
      <div class="lg:col-span-3 reveal">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent font-display">About</h2>
      </div>

      <!-- Right side: Content -->
      <div class="lg:col-span-9 flex flex-col gap-10">
        <!-- Big statement -->
        <p class="text-2xl sm:text-3xl font-black text-ink leading-snug tracking-tight reveal">
          I bridge the gap between complex backend architectures and clean user experiences, delivering scalable web operations that support real business growth.
        </p>

        <!-- Services grid -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-muted mb-6 reveal">Core Focus & Services</h3>
          <div class="grid gap-6 sm:grid-cols-3 reveal-stagger">
            <!-- Service 1: WooCommerce -->
            <div class="tilt-card p-6 rounded-3xl border border-line bg-surface-muted shadow-sm flex flex-col justify-between hover:border-ink/20 transition-all duration-300">
              <div class="flex flex-col gap-4">
                <!-- Icon -->
                <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-ink">E-Commerce & WooCommerce</h4>
                <p class="text-xs text-ink-muted leading-relaxed">
                  Building responsive WooCommerce storefronts, payment gateway integrations, shipping modules, and performance tuning for high-traffic environments.
                </p>
              </div>
            </div>

            <!-- Service 2: Highlighted Purple Card (Business Automation) -->
            <div class="tilt-card p-6 rounded-3xl bg-accent text-accent-foreground shadow-lg flex flex-col justify-between relative overflow-hidden transition-transform duration-300 hover:scale-[1.02]">
              <div class="flex flex-col gap-4 relative z-10">
                <!-- Icon -->
                <div class="w-10 h-10 rounded-xl bg-white/20 text-white flex items-center justify-center">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <h4 class="text-lg font-bold">Business Process Automation</h4>
                <p class="text-xs opacity-90 leading-relaxed">
                  Designing automated order workflows, web scraping tasks for data sync, Gravity Forms pipelines, and third-party REST API integrations.
                </p>
              </div>
              <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
            </div>

            <!-- Service 3: Custom WordPress -->
            <div class="tilt-card p-6 rounded-3xl border border-line bg-surface-muted shadow-sm flex flex-col justify-between hover:border-ink/20 transition-all duration-300">
              <div class="flex flex-col gap-4">
                <!-- Icon -->
                <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-ink">Custom Data Architectures</h4>
                <p class="text-xs text-ink-muted leading-relaxed">
                  Designing PODS and Custom Post Type (CPT) models to architect structured databases, enabling seamless front-end listings and admin usability.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
